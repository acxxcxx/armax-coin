# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Shell scripts and Makefile must strictly use LF
*.sh text eol=lf
Makefile text eol=lf

# Go sources, docs, configs, and CI workflows
*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.example text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.ps1 text eol=crlf
*.manifest text eol=crlf

# Binary files
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.tar.gz binary
*.zip binary
*.syso binary
*.db binary
